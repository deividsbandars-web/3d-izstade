FROM node:22-alpine AS builder

WORKDIR /app

# Native modules such as canvas need build tooling even for backend-only builds.
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    pkgconfig \
    pixman-dev \
    cairo-dev \
    pango-dev \
    libjpeg-turbo-dev \
    giflib-dev

# Install both root and backend-server dependencies because the full backend
# compiles backend-server together with ../src runtime modules.
COPY package.json package-lock.json ./
COPY backend-server/package.json backend-server/package-lock.json ./backend-server/

RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund --prefer-offline
RUN --mount=type=cache,target=/root/.npm cd backend-server && npm ci --no-audit --no-fund --prefer-offline

# Copy only the backend/full-platform inputs needed by backend-server/tsconfig.json.
# Keep local env files, tests, dist output, and worker smoke logs out of build layers.
COPY backend-server/env.ts backend-server/server.ts backend-server/worker.ts backend-server/types.d.ts backend-server/tsconfig.json ./backend-server/
COPY backend-server/config ./backend-server/config
COPY backend-server/controllers ./backend-server/controllers
COPY backend-server/events ./backend-server/events
COPY backend-server/lib ./backend-server/lib
COPY backend-server/middleware ./backend-server/middleware
COPY backend-server/observability ./backend-server/observability
COPY backend-server/routes/api.ts backend-server/routes/landing.ts ./backend-server/routes/
COPY backend-server/schemas ./backend-server/schemas
COPY backend-server/services ./backend-server/services
COPY src ./src
COPY docs/booth-slot-bank.json ./docs/booth-slot-bank.json
COPY tsconfig.json tsconfig.app.json tsconfig.node.json ./

RUN cd backend-server && npm run build

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Runtime ships the compiled full backend. The source tree is intentionally not
# copied into the release image so production cannot drift back to tsx.
COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/backend-server/package.json /app/backend-server/package-lock.json ./backend-server/
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/backend-server/node_modules ./backend-server/node_modules
COPY --from=builder /app/backend-server/dist ./backend-server/dist
COPY --from=builder /app/docs/booth-slot-bank.json ./docs/booth-slot-bank.json

EXPOSE 3000 3001

CMD ["node", "backend-server/dist/backend-server/server.js"]
