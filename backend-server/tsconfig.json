{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "../../src/*": ["../src/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": [
    "**/*.ts",
    "../src/backend/**/*.ts",
    "../src/lib/**/*.ts",
    "../src/core/**/*.ts",
    "../src/services/**/*.ts",
    "types.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
