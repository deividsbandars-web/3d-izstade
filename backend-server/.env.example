# Warpala backend-server env example
# Copy values from your secret manager. Do not commit real secrets.

# Optional | consumer: backend runtime | default: development
NODE_ENV=production

# Optional | consumer: backend runtime | default: 3000
PORT=3000

# Optional | consumer: backend client IP normalization | default: 0, do not trust X-Forwarded-* headers
# Set to the exact number of trusted reverse proxy hops in staging/production.
BACKEND_TRUST_PROXY_HOPS=0

# Optional | consumer: backend browser CORS policy | default: canonical production/staging origins
# Add exact preview origins explicitly; wildcard origins are not supported.
BACKEND_CORS_ALLOWED_ORIGINS=https://www.30sek24.com,https://staging.30sek24.com

# Optional | consumer: public Expo/calculator lead route limits | defaults: 5 requests / 10 minutes / route / IP
PUBLIC_EXPO_LEAD_RATE_LIMIT_MAX_REQUESTS=5
PUBLIC_CALCULATOR_LEAD_RATE_LIMIT_MAX_REQUESTS=5
PUBLIC_LEAD_RATE_LIMIT_WINDOW_MS=600000

# Optional | consumer: public Expo/calculator lead duplicate suppression | default: 30 minutes
PUBLIC_LEAD_DUPLICATE_WINDOW_MS=1800000

# Optional | consumer: public Expo/calculator lead Turnstile rollout | default: optional/disabled
# Required mode fails backend startup unless the secret key is configured.
PUBLIC_LEAD_TURNSTILE_SECRET_KEY=
PUBLIC_LEAD_TURNSTILE_REQUIRED=false
PUBLIC_LEAD_TURNSTILE_TIMEOUT_MS=5000

# Required | consumer: backend runtime Supabase service client | default: none
SUPABASE_URL=https://your-project-ref.supabase.co

# Required | consumer: backend runtime Supabase service client | default: none
SUPABASE_SERVICE_KEY=replace-with-supabase-service-role-key

# Optional | consumer: shared Supabase anon/auth helper compiled into backend | default: unset
SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Optional legacy alias | consumer: root shared admin helper | default: falls back to SUPABASE_SERVICE_KEY when available
SUPABASE_SERVICE_ROLE_KEY=

# Optional | consumer: API/global, public lead, quote, event, and scheduler infrastructure | default: production writes fail closed without Redis
# Use redis:// only for local/private/internal Redis. Remote managed Redis (including Upstash) must use rediss:// with certificate validation.
REDIS_URL=redis://127.0.0.1:6379

# Optional | consumer: backend billing checkout | default: checkout endpoint returns 503 when missing
STRIPE_SECRET_KEY=

# Optional | consumer: backend billing webhook | default: webhook endpoint returns 503 when missing
STRIPE_WEBHOOK_SECRET=

# Optional | consumer: backend billing checkout | default: derived from BILLING_PUBLIC_APP_URL when possible
BILLING_CHECKOUT_SUCCESS_URL=https://www.30sek24.com/billing/success?session_id={CHECKOUT_SESSION_ID}
BILLING_CHECKOUT_CANCEL_URL=https://www.30sek24.com/billing/cancel
BILLING_PUBLIC_APP_URL=https://www.30sek24.com

# Optional | consumer: backend Pixel Streaming/operator routes | default: false
PIXEL_STREAMING_ROUTES_ENABLED=false

# Optional legacy alias | consumer: backend Pixel Streaming/operator routes | default: false
PIXEL_STREAMING_ENABLED=false

# Required only when PIXEL_STREAMING_ROUTES_ENABLED=true | consumer: Pixel Streaming status/session routes | default: none
SIGNALING_STATUS_BASE_URL=

# Required only when PIXEL_STREAMING_ROUTES_ENABLED=true | consumer: /api/expo/cities UE5 API-key middleware | default: none
UE5_SECRET_KEY=

# Optional | consumer: Pixel Streaming status/session routes | default: 2500
PIXEL_STREAMING_STATUS_TIMEOUT_MS=2500

# Optional | consumer: deployment environment detection | default: unset
APP_ENV=
VERCEL_ENV=

# Optional | consumer: modular-home quote endpoint gate | default: disabled
MODULAR_HOME_QUOTE_SUBMISSION_ENABLED=false

# Optional | consumer: modular-home quote staging host allowlist | default: localhost/staging defaults in code
MODULAR_HOME_QUOTE_STAGING_HOSTS=staging.30sek24.com,api-staging.30sek24.com,localhost,127.0.0.1

# Optional | consumer: modular-home quote production host allowlist | default: none
MODULAR_HOME_QUOTE_PRODUCTION_HOSTS=

# Optional | consumer: modular-home quote anti-spam | default: optional verification
MODULAR_HOME_QUOTE_TURNSTILE_SECRET_KEY=
MODULAR_HOME_QUOTE_TURNSTILE_REQUIRED=false

# Optional | consumer: modular-home quote email handoff | default: disabled
MODULAR_HOME_QUOTE_EMAIL_HANDOFF_ENABLED=false

# Optional | consumer: modular-home quote email handoff sender | default: RESEND_FROM_EMAIL fallback, then unset
MODULAR_HOME_QUOTE_EMAIL_FROM=
RESEND_FROM_EMAIL=

# Optional | consumer: modular-home quote email handoff reply-to | default: unset
MODULAR_HOME_QUOTE_EMAIL_REPLY_TO=

# Optional | consumer: modular-home quote email handoff recipients | default: unset
MODULAR_HOME_QUOTE_EMAIL_HANDOFF_TO=

# Optional | consumer: modular-home quote email handoff provider | default: unset; required only when email handoff is enabled
RESEND_API_KEY=

# Optional | consumer: legacy/shared backend AI and search helpers | default: unset
OPENAI_API_KEY=
GEMINI_API_KEY=
SERPAPI_KEY=
