# Warpala root Vite SPA / compose env example
# Copy values from your secret manager. Do not commit real secrets.

# Required | consumer: frontend build (Vite SPA API client) | default: none
VITE_PUBLIC_API_BASE_URL=https://api.30sek24.com

# Required | consumer: frontend build (Supabase browser client) | default: none
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Required | consumer: frontend build (Supabase browser client) | default: none
VITE_SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Optional | consumer: frontend build (auth redirects/share URLs) | default: derived from VITE_PUBLIC_API_BASE_URL when possible
VITE_PUBLIC_APP_URL=https://www.30sek24.com

# Optional | consumer: frontend build (Pixel Streaming/operator support only) | default: unset/null
VITE_SIGNALING_SERVER_URL=

# Optional | consumer: frontend build (WebRTC ICE hints for Pixel Streaming/operator support only) | default: empty list
VITE_STUN_SERVER_URLS=stun:stun.l.google.com:19302

# Optional | consumer: frontend build (WebRTC ICE hints for Pixel Streaming/operator support only) | default: empty list
VITE_TURN_SERVER_URLS=

# Optional | consumer: frontend build (TURN credentials; set both username and password or neither) | default: unset/null
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=

# Optional | consumer: frontend build (Pixel Streaming status probe) | default: 2500
VITE_PIXEL_STREAMING_PROBE_TIMEOUT_MS=2500

# Optional | consumer: frontend build (3D QA instrumentation flag) | default: disabled
VITE_ENABLE_3D_QA=0

# Optional | consumer: frontend build (demo/stub routes) | default: disabled
VITE_ENABLE_DEMO=0

# Optional | consumer: frontend build (expo quality preset override) | default: runtime auto
VITE_EXPO_QUALITY_PRESET=

# Optional | consumer: legacy shared search helper | default: unset
VITE_SERPAPI_KEY=

# Required for docker-compose backend service | consumer: backend runtime | default: none
# The standalone backend example lives at backend-server/.env.example.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=replace-with-supabase-service-role-key

# Optional for docker-compose/backend auth helper compatibility | consumer: backend shared Supabase anon client | default: unset
SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# Optional | consumer: backend runtime rate limiting/session infrastructure | default: production quote submissions fail closed without Redis
REDIS_URL=redis://redis:6379

# Optional | consumer: backend billing checkout | default: checkout endpoint returns 503 when missing
STRIPE_SECRET_KEY=

# Optional | consumer: backend billing webhook | default: webhook endpoint returns 503 when missing
STRIPE_WEBHOOK_SECRET=

# Optional | consumer: backend billing checkout | default: derived from BILLING_PUBLIC_APP_URL/VITE_PUBLIC_APP_URL when possible
BILLING_CHECKOUT_SUCCESS_URL=https://www.30sek24.com/billing/success?session_id={CHECKOUT_SESSION_ID}
BILLING_CHECKOUT_CANCEL_URL=https://www.30sek24.com/billing/cancel
BILLING_PUBLIC_APP_URL=https://www.30sek24.com

# Optional | consumer: backend runtime | default: development
NODE_ENV=production

# Optional | consumer: backend runtime | default: 3000
PORT=3000

# Optional | consumer: backend Pixel Streaming/operator routes | default: false
PIXEL_STREAMING_ROUTES_ENABLED=false

# Required only when PIXEL_STREAMING_ROUTES_ENABLED=true | consumer: backend Pixel Streaming status/session routes | default: none
SIGNALING_STATUS_BASE_URL=
UE5_SECRET_KEY=

# Optional | consumer: backend Pixel Streaming status/session routes | default: 2500
PIXEL_STREAMING_STATUS_TIMEOUT_MS=2500

# Optional | consumer: docker-compose signaling/TURN services | default: compose-specific fallback where defined
STUN_SERVER_URLS=stun:stun.l.google.com:19302
TURN_SERVER_URLS=
TURN_USERNAME=
TURN_PASSWORD=
TURN_REALM=30sek24.com
TURN_PUBLIC_IP=
TURN_PUBLIC_HOST=
TURN_LISTEN_IP=0.0.0.0
TURN_MIN_PORT=49260
TURN_MAX_PORT=49279

# Optional | consumer: modular-home quote backend | default: disabled
MODULAR_HOME_QUOTE_SUBMISSION_ENABLED=false

# Optional | consumer: modular-home quote backend staging host gate | default: localhost/staging defaults in code
MODULAR_HOME_QUOTE_STAGING_HOSTS=staging.30sek24.com,api-staging.30sek24.com,localhost,127.0.0.1

# Optional | consumer: modular-home quote backend production host gate | default: none
MODULAR_HOME_QUOTE_PRODUCTION_HOSTS=

# Optional | consumer: modular-home quote anti-spam | default: optional verification
MODULAR_HOME_QUOTE_TURNSTILE_SECRET_KEY=
MODULAR_HOME_QUOTE_TURNSTILE_REQUIRED=false

# Optional | consumer: modular-home quote email handoff | default: disabled
MODULAR_HOME_QUOTE_EMAIL_HANDOFF_ENABLED=false
MODULAR_HOME_QUOTE_EMAIL_FROM=
MODULAR_HOME_QUOTE_EMAIL_REPLY_TO=
MODULAR_HOME_QUOTE_EMAIL_HANDOFF_TO=
RESEND_API_KEY=

# Optional | consumer: legacy/shared backend AI/search helpers | default: unset
OPENAI_API_KEY=
GEMINI_API_KEY=
SERPAPI_KEY=
