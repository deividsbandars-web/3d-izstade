# ==========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase (Database & Auth)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Backend specific overrides (Bypasses RLS for system operations)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_KEY="your-service-role-key"

# AI Providers
OPENAI_API_KEY="sk-your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# Payments (Stripe)
STRIPE_SECRET="sk_live_your_stripe_secret"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Infrastructure
REDIS_URL="redis://localhost:6379"
NODE_ENV="production"
PORT=3000

# Pixel Streaming
VITE_SIGNALING_SERVER_URL="wss://app.warpala.lv/ws/"
# Legacy non-compose fallback. Docker compose mirrors the canonical TURN/STUN
# values below into the frontend build args, so this JSON blob is optional.
VITE_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'
VITE_PIXEL_STREAMING_PROBE_TIMEOUT_MS="2500"
SIGNALING_STATUS_BASE_URL="http://127.0.0.1"
PIXEL_STREAMING_STATUS_TIMEOUT_MS="2500"

# Canonical TURN/STUN source of truth for signaling + compose.
# Frontend Vite build mirrors these values via docker-compose build args.
# TURN_SERVER_URLS supports a comma-separated list, so keep UDP/TCP/TLS
# candidates in one value instead of redefining the variable multiple times.
STUN_SERVER_URLS="stun:stun.l.google.com:19302"
TURN_SERVER_URLS="turn:turn.warpala.lv:3478?transport=udp,turn:turn.warpala.lv:3478?transport=tcp,turns:turn.warpala.lv:5349?transport=tcp"
TURN_USERNAME="pixelstream_user"
TURN_PASSWORD="nomaini-uz-garu-random-paroli"
TURN_REALM="warpala.lv"
TURN_PUBLIC_IP="203.0.113.25"
TURN_LISTEN_IP="0.0.0.0"
TURN_MIN_PORT="49260"
TURN_MAX_PORT="49300"

# Optional smoke-check overrides for operator verification.
PIXEL_STREAMING_STATUS_URL="http://127.0.0.1/api/pixel-streaming/status"
PIXEL_STREAMING_SIGNALING_STATUS_URL="http://127.0.0.1/api/status"
PIXEL_STREAMING_SIGNALING_STREAMERS_URL="http://127.0.0.1/api/streamers"
PIXEL_STREAMING_SIGNALING_CONFIG_URL="http://127.0.0.1/api/config"
PIXEL_STREAMING_SMOKE_TIMEOUT_MS="4000"
