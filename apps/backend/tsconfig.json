{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "../../",
    "baseUrl": ".",
    "paths": {
      "../../src/*": ["../../src/*"],
      "../src/*": ["../../src/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": [
    "C:/3d/apps/backend/**/*.ts",
    "C:/3d/src/backend/**/*.ts",
    "C:/3d/src/lib/**/*.ts",
    "C:/3d/src/core/**/*.ts",
    "C:/3d/src/services/**/*.ts",
    "types.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
