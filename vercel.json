{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|textures/|expo/media/|models/|audio/|videos/|icons/|manifest.webmanifest|registerSW.js|sw.js|workbox-.*|favicon.ico|vite.svg).*)",
      "destination": "/index.html"
    }
  ]
}
